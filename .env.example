# Скопируй в .env и заполни своими значениями.
# .env в git не попадёт (см. .gitignore).

# Django
DJANGO_SECRET_KEY=replace-me-with-long-random-string
DEBUG=False
ALLOWED_HOSTS=.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.railway.app

# Telegram bot
BOT_TOKEN=token-from-BotFather

# Database (Railway пробрасывает автоматически — локально не нужно, останется sqlite)
# DATABASE_URL=postgres://user:password@host:5432/dbname
